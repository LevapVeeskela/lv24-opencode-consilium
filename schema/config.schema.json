{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LevapVeeskela/opencode-consilium/main/schema/config.schema.json",
  "title": "opencode-consilium configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "experts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/expert" }
    },
    "chair": { "$ref": "#/definitions/chair" },
    "excludedAgents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "expert": { "type": "integer", "minimum": 1000 },
        "chair": { "type": "integer", "minimum": 1000 },
        "shutdown": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "expertRetries": { "type": "integer", "minimum": 0 },
        "chairRetries": { "type": "integer", "minimum": 0 },
        "delay": { "type": "integer", "minimum": 0 },
        "exponentialBackoff": { "type": "boolean" },
        "jitter": { "type": "boolean" },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "file": { "type": ["string", "boolean"] },
        "format": { "enum": ["text", "markdown", "json"] },
        "progress": { "type": "boolean" },
        "logLevel": { "enum": ["silent", "error", "warn", "info", "debug"] }
      },
      "additionalProperties": false
    },
    "autoDiscoverAgents": { "type": "boolean" },
    "opencodeConfigPath": { "type": "string" },
    "opencodePath": { "type": "string" },
    "opencodeArgs": { "type": "array", "items": { "type": "string" } },
    "cwd": { "type": "string" },
    "standalone": { "type": "boolean" },
    "autoApprove": { "type": "boolean" },
    "artifacts": { "type": ["string", "boolean"] },
    "consensus": { "type": "boolean" },
    "smartExperts": { "type": "boolean" },
    "maxCost": { "type": "number", "minimum": 0 },
    "fallbackModels": { "type": "array", "items": { "type": "string" } },
    "session": { "type": "string", "minLength": 1 },
    "report": { "enum": ["html", "pr", "markdown"] },
    "reportFile": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "debounceMs": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/#+-]+/[A-Za-z0-9._:@/#+-]+$"
    },
    "expert": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/definitions/model" },
        "prompt": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 1000 },
        "retries": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "chair": {
      "type": "object",
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/definitions/model" },
        "timeout": { "type": "integer", "minimum": 1000 },
        "maxExpertTextLength": { "type": "integer", "minimum": 500 }
      },
      "additionalProperties": false
    }
  }
}
