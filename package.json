{
  "name": "lv24-opencode-consilium",
  "version": "1.7.0",
  "description": "Консилиум ИИ-экспертов для OpenCode CLI: мульти-модельный совет, MCP-сервер и подбор сильнейших бесплатных моделей",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "consilium": "bin/cli.js",
    "consilium-mcp": "bin/mcp.js",
    "lv24-opencode-consilium": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": "./dist/config.js",
    "./agents": "./dist/agents.js",
    "./models": "./dist/models.js",
    "./presets": "./dist/presets.js",
    "./doctor": "./dist/doctor.js",
    "./verify": "./dist/verify.js",
    "./mcp": "./dist/mcp.js",
    "./compat": "./dist/compat.js",
    "./stream": "./dist/stream.js",
    "./defaults": "./dist/defaults.js",
    "./artifacts": "./dist/artifacts.js",
    "./consensus": "./dist/consensus.js",
    "./smart-experts": "./dist/smart-experts.js",
    "./fallback": "./dist/fallback.js",
    "./report": "./dist/report.js",
    "./watch": "./dist/watch.js",
    "./variants": "./dist/variants.js",
    "./replay": "./dist/replay.js",
    "./tool-run": "./dist/tool-run.js",
    "./plugin": "./dist/plugin.js",
    "./server": "./dist/plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "schema",
    "docs",
    "eval",
    "llms.txt",
    "consilium.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "ai",
    "agents",
    "consilium",
    "llm",
    "code-review",
    "architecture",
    "mcp",
    "model-context-protocol",
    "free-models"
  ],
  "author": "LevapVeeskela (paulalexeev10@gmail.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevapVeeskela/lv24-opencode-consilium.git"
  },
  "bugs": {
    "url": "https://github.com/LevapVeeskela/lv24-opencode-consilium/issues"
  },
  "homepage": "https://github.com/LevapVeeskela/lv24-opencode-consilium#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
