{
  "name": "opencode-consilium",
  "version": "1.1.0",
  "description": "Консилиум ИИ-экспертов для OpenCode CLI: мульти-модельный совет, MCP-сервер и подбор сильнейших бесплатных моделей",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "consilium": "bin/cli.js",
    "consilium-mcp": "bin/mcp.js",
    "opencode-consilium": "bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": "./dist/config.js",
    "./agents": "./dist/agents.js",
    "./models": "./dist/models.js",
    "./presets": "./dist/presets.js",
    "./doctor": "./dist/doctor.js",
    "./verify": "./dist/verify.js",
    "./mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "schema",
    "consilium.config.example.json",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "ai",
    "agents",
    "consilium",
    "llm",
    "code-review",
    "architecture",
    "mcp",
    "model-context-protocol",
    "free-models"
  ],
  "author": "LevapVeeskela (paulalexeev10@gmail.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevapVeeskela/opencode-consilium.git"
  },
  "bugs": {
    "url": "https://github.com/LevapVeeskela/opencode-consilium/issues"
  },
  "homepage": "https://github.com/LevapVeeskela/opencode-consilium#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
